# Salin ke deploy/.env di VPS lalu isi:   cp .env.example .env && chmod 600 .env
# File .env berisi rahasia produksi: JANGAN di-commit, JANGAN dikirim lewat chat.

# Domain utama (tanpa https://) & email untuk notifikasi sertifikat Let's Encrypt.
DOMAIN=luanna.shop
ACME_EMAIL=

# Database. Pakai huruf/angka saja (masuk ke connection string):  openssl rand -hex 32
POSTGRES_PASSWORD=

# Kunci tanda tangan JWT, acak & unik untuk produksi:  openssl rand -base64 48
# Mengganti kunci ini membuat semua user harus login ulang.
JWT_KEY=

# Midtrans. Mulai dengan sandbox (false + server key sandbox), pindah ke true + key production
# setelah alur bayar diuji di domain asli.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Email OTP via Resend. FromAddress harus dari domain yang sudah diverifikasi di Resend.
EMAIL_MODE=Smtp
EMAIL_FROM_ADDRESS=noreply@luanna.shop
RESEND_API_KEY=

# Google. Client ID web bukan rahasia. Key Maps browser dibatasi HTTP referrer https://luanna.shop/*;
# key Maps server (Geocoding) rahasia. Boleh kosong selama fitur peta belum diaktifkan.
GOOGLE_WEB_CLIENT_ID=331482618694-7lbeh050haoe6p544ppgdkucbld57fk3.apps.googleusercontent.com
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
